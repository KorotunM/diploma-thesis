										type:     "POST",
										url:     url+"/ajax/ajsendcomment.php", 
										dataType: "html",

										data: {
											head1:head1,
											head2:head2,
											type:type,
											answer:answer
										},				
										success: function(response) {
												if(head2!=='0'){
													showdopcomment(url,head1,head2,type);
												}
